# --- Node / Vite (frontend) -------------------------------------------------
node_modules
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Rust / Cargo (src-tauri) ---------------------------------------------
# The build directory is many GB. `src-tauri/.gitignore` also covers it;
# this keeps it out no matter where the build runs from.
target/
**/*.rs.bk
*.pdb

# --- Tauri ---------------------------------------------------------------
# Auto-generated capability schemas (regenerated on build).
src-tauri/gen/schemas/
# Bundled installers.
src-tauri/target/release/bundle/
# Signing material — never commit these.
*.key
*.jks
*.keystore
*.pfx
*.p12
src-tauri/*.pem
state.json
state.json.*
state.corrupt-*.json
state.oversized-*.json
security-reports/

# --- Secrets / local config -------------------------------------------------
.env
.env.*
!.env.example

# --- Tooling --------------------------------------------------------------
# Local working state for the "impeccable" review tool.
.impeccable/
# Scratch / AI-assistant working files.
.claude/
CLAUDE.local.md

# --- Editors / OS -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
